---
<!-- 字体预加载 -->
<link rel="preconnect" href="https://cdn.xrbk.cn" crossorigin>
<link rel="preload" href="https://cdn.xrbk.cn/fonts/ChillRoundFRegular/result.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://cdn.xrbk.cn/fonts/ChillRoundFRegular/result.css"></noscript>

<!-- 字体显示优化 -->
<style>
    /* 字体显示策略优化 */
    @font-face {
        font-family: '寒蝉全圆体';
        src: url('https://cdn.xrbk.cn/fonts/ChillRoundFRegular/ChillRoundFRegular.woff2') format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    
    /* 系统字体回退优化 */
    :root {
        --font-primary: '寒蝉全圆体', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        --font-system: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
    
    /* 字体加载期间的回退样式 */
    body {
        font-family: var(--font-system);
    }
    
    /* 字体加载完成后应用主字体 */
    @font-face {
        font-family: '寒蝉全圆体';
        src: url('https://cdn.xrbk.cn/fonts/ChillRoundFRegular/ChillRoundFRegular.woff2') format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    
    /* 优化字体渲染 */
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }
</style>
